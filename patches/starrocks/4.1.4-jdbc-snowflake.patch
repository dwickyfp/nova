+        SnowflakeSchemaResolver resolver = new SnowflakeSchemaResolver(catalogProperties(
+                "jdbc:snowflake://acct.snowflakecomputing.com/?db=ANALYTICS&jdbc_treat_decimal_as_int=FALSE",
