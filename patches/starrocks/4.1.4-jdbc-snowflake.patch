+    @Test
+    public void testTypeMapping() {
+        SnowflakeSchemaResolver resolver = new SnowflakeSchemaResolver();
+        Type bigint = TypeFactory.createType(PrimitiveType.BIGINT);
+        // NUMBER(p,0), including the INT/BIGINT aliases (NUMBER(38,0)), is read as java.lang.Long.
+        assertType(bigint, resolver.convertColumnType(Types.BIGINT, "NUMBER", 38, 0));
+        assertType(bigint, resolver.convertColumnType(Types.DECIMAL, "NUMBER", 38, 0));
+        assertType(bigint, resolver.convertColumnType(Types.NUMERIC, "NUMBER", 10, 0));
+        assertType(TypeFactory.createUnifiedDecimalType(12, 2),
+                resolver.convertColumnType(Types.DECIMAL, "NUMBER", 12, 2));
+        assertType(TypeFactory.createUnifiedDecimalType(38, 10),
+                resolver.convertColumnType(Types.DECIMAL, "NUMBER", 38, 10));
+        assertType(TypeFactory.createType(PrimitiveType.DOUBLE),
+                resolver.convertColumnType(Types.DOUBLE, "FLOAT", 38, 0));
+        assertType(TypeFactory.createType(PrimitiveType.BOOLEAN),
+                resolver.convertColumnType(Types.BOOLEAN, "BOOLEAN", 1, 0));
+        assertType(TypeFactory.createVarcharType(255),
+                resolver.convertColumnType(Types.VARCHAR, "VARCHAR", 255, 0));
+        // TEXT/STRING default to 16 MB (newer accounts 128 MB): both fit the catalog maximum.
+        assertType(TypeFactory.createVarcharType(16777216),
+                resolver.convertColumnType(Types.VARCHAR, "VARCHAR", 16777216, 0));
+        assertType(TypeFactory.createVarcharType(134217728),
+                resolver.convertColumnType(Types.VARCHAR, "TEXT", 134217728, 0));
+        assertType(TypeFactory.createDefaultCatalogString(),
+                resolver.convertColumnType(Types.VARCHAR, "VARCHAR", 0, 0));
+        assertType(TypeFactory.createType(PrimitiveType.JSON),
+                resolver.convertColumnType(Types.VARCHAR, "VARIANT", 16777216, 0));
+        assertType(TypeFactory.createType(PrimitiveType.JSON),
+                resolver.convertColumnType(Types.VARCHAR, "OBJECT", 16777216, 0));
+        assertType(TypeFactory.createType(PrimitiveType.JSON),
+                resolver.convertColumnType(Types.VARCHAR, "ARRAY", 16777216, 0));
+        assertType(TypeFactory.createDefaultCatalogString(),
+                resolver.convertColumnType(Types.STRUCT, "OBJECT", 0, 0));
+        assertType(TypeFactory.createDefaultCatalogString(),
+                resolver.convertColumnType(Types.ARRAY, "ARRAY", 0, 0));
+        assertType(TypeFactory.createDefaultCatalogString(),
+                resolver.convertColumnType(Types.OTHER, "GEOGRAPHY", 0, 0));
+        assertType(TypeFactory.createVarbinary(TypeFactory.CATALOG_MAX_VARCHAR_LENGTH),
+                resolver.convertColumnType(Types.BINARY, "BINARY", 8388608, 0));
+        assertType(TypeFactory.createType(PrimitiveType.DATE),
+                resolver.convertColumnType(Types.DATE, "DATE", 10, 0));
+        assertType(TypeFactory.createType(PrimitiveType.TIME),
+                resolver.convertColumnType(Types.TIME, "TIME", 18, 9));
+        for (String name : new String[] {"TIMESTAMPNTZ", "TIMESTAMP_NTZ", "TIMESTAMPLTZ", "TIMESTAMP_LTZ"}) {
+            assertType(TypeFactory.createType(PrimitiveType.DATETIME),
+                    resolver.convertColumnType(Types.TIMESTAMP, name, 29, 9));
+        }
+        assertType(TypeFactory.createType(PrimitiveType.DATETIME),
+                resolver.convertColumnType(Types.TIMESTAMP_WITH_TIMEZONE, "TIMESTAMPTZ", 35, 9));
+        assertType(TypeFactory.createType(PrimitiveType.UNKNOWN_TYPE),
+                resolver.convertColumnType(Types.OTHER, "SOMETHING_NEW", 0, 0));
+    }
