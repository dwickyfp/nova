+    @Test
+    public void testColumnsKeepStoredNames() throws SQLException {
+        FakeSnowflake snowflake = new FakeSnowflake();
+        snowflake.columns.add(column("ORDER_ID", Types.BIGINT, "NUMBER", 38, 0, "NO", "order key"));
+        snowflake.columns.add(column("Mixed Case", Types.VARCHAR, "VARCHAR", 64, 0, "YES", null));
+        snowflake.columns.add(column("PAYLOAD", Types.VARCHAR, "VARIANT", 16777216, 0, "YES", null));
+        SnowflakeSchemaResolver resolver = new SnowflakeSchemaResolver();
+        Map<String, Integer> jdbcTypes = new HashMap<>();
+        List<Column> columns;
+        try (ResultSet rs = resolver.getColumns(snowflake.connection(), "PUBLIC", "ORDERS")) {
+            columns = resolver.convertToSRTable(rs, jdbcTypes);
+        }
+        Assertions.assertEquals(3, columns.size());
+        Assertions.assertEquals("ORDER_ID", columns.get(0).getName());
+        Assertions.assertEquals("order key", columns.get(0).getComment());
+        Assertions.assertFalse(columns.get(0).isAllowNull());
+        // Quoting happens in the scan node, so names stay as stored.
+        Assertions.assertEquals("Mixed Case", columns.get(1).getName());
+        Assertions.assertTrue(columns.get(2).getType().isJsonType());
+        Assertions.assertEquals(Types.BIGINT, jdbcTypes.get("order_id"));
+    }
