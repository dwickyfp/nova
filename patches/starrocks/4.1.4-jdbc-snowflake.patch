+    @Test
+    public void testDriverClassLoaderVerifiesLocalJar(@TempDir Path dir) throws Exception {
+        File jar = dir.resolve("probe-driver.jar").toFile();
+        try (OutputStream out = Files.newOutputStream(jar.toPath());
+                JarOutputStream jarOut = new JarOutputStream(out)) {
+            jarOut.putNextEntry(new JarEntry("nova-driver-probe.txt"));
+            jarOut.write("probe".getBytes(StandardCharsets.UTF_8));
+            jarOut.closeEntry();
+        }
+        String url = jar.toURI().toString();
+        String checksum = JDBCDriverClassLoaders.md5Hex(jar);
+
+        ClassLoader loader = JDBCDriverClassLoaders.forDriver(url, checksum);
+        Assertions.assertNotNull(loader.getResource("nova-driver-probe.txt"));
+        Assertions.assertSame(loader, JDBCDriverClassLoaders.forDriver(url, checksum.toUpperCase()));
+
+        Assertions.assertThrows(StarRocksConnectorException.class,
+                () -> JDBCDriverClassLoaders.forDriver(url, "0123456789abcdef0123456789abcdef"));
+        Assertions.assertThrows(StarRocksConnectorException.class,
+                () -> JDBCDriverClassLoaders.forDriver(url, null));
+        Assertions.assertThrows(StarRocksConnectorException.class,
+                () -> JDBCDriverClassLoaders.forDriver(dir.resolve("missing.jar").toUri().toString(), checksum));
+        Assertions.assertThrows(StarRocksConnectorException.class,
+                () -> JDBCDriverClassLoaders.forDriver("http://example.invalid/driver.jar", checksum));
+    }
