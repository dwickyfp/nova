+package com.starrocks.connector.jdbc;
+
+import com.google.common.collect.ImmutableSet;
+import com.google.common.collect.Lists;
+import com.starrocks.catalog.Column;
+import com.starrocks.catalog.JDBCResource;
+import com.starrocks.catalog.JDBCTable;
+import com.starrocks.catalog.Table;
+import com.starrocks.common.DdlException;
+import com.starrocks.common.util.TimeUtils;
+import com.starrocks.connector.exception.StarRocksConnectorException;
+import com.starrocks.type.PrimitiveType;
+import com.starrocks.type.Type;
+import com.starrocks.type.TypeFactory;
+
+import java.sql.Connection;
+import java.sql.DatabaseMetaData;
+import java.sql.PreparedStatement;
+import java.sql.ResultSet;
+import java.sql.SQLException;
+import java.sql.Types;
+import java.util.Collection;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+
+/**
+ * Schema resolver for the Snowflake JDBC driver.
+ *
+ * <p>A StarRocks JDBC catalog maps to the single Snowflake database selected by the connection
+ * ({@code db=} in the JDBC URI); StarRocks databases are Snowflake schemas. Names are used exactly as
+ * Snowflake stores them (unquoted identifiers are upper case), and every remote identifier is
+ * double-quoted, so lookups never depend on Snowflake's case folding.
+ */
+public class SnowflakeSchemaResolver extends JDBCSchemaResolver {
+
+    /**
+     * Snowflake session parameter that decides how scale-0 NUMBER columns are typed in result sets.
+     * With the driver default (true) they are reported as BIGINT and read as java.lang.Long, which the BE
+     * JDBC scanner only accepts for BIGINT slots. When disabled they are read as java.math.BigDecimal.
+     */
+    static final String TREAT_DECIMAL_AS_INT = "JDBC_TREAT_DECIMAL_AS_INT";
+
+    private final boolean treatDecimalAsInt;
+
+    public SnowflakeSchemaResolver() {
+        this(Map.of());
+    }
+
+    public SnowflakeSchemaResolver(Map<String, String> properties) {
+        this.defaultTableTypes = new String[] {"TABLE", "VIEW"};
+        this.treatDecimalAsInt = !"false".equalsIgnoreCase(
+                uriParameter(properties.getOrDefault(JDBCResource.URI, ""), TREAT_DECIMAL_AS_INT));
+    }
+
+    static boolean isSnowflakeDriver(String driverClass) {
+        return driverClass != null && driverClass.toLowerCase(Locale.ROOT).contains("snowflake");
+    }
+
+    static boolean isSnowflakeUri(String jdbcUri) {
+        return jdbcUri != null && jdbcUri.toLowerCase(Locale.ROOT).startsWith("jdbc:snowflake:");
+    }
+
+    /** Returns the value of a {@code key=value} URI parameter (case-insensitive key), or null. */
+    static String uriParameter(String jdbcUri, String key) {
+        int start = jdbcUri.indexOf('?');
+        if (start < 0) {
+            return null;
+        }
+        for (String pair : jdbcUri.substring(start + 1).split("&")) {
+            int eq = pair.indexOf('=');
+            if (eq > 0 && pair.substring(0, eq).trim().equalsIgnoreCase(key)) {
+                return pair.substring(eq + 1).trim();
+            }
+        }
+        return null;
+    }
+
+    /** Quotes a Snowflake identifier exactly as stored, doubling embedded quotes. */
+    static String quoteIdentifier(String identifier) {
+        return "\"" + identifier.replace("\"", "\"\"") + "\"";
+    }
+
+    private static String currentDatabase(Connection connection) throws SQLException {
+        String database = connection.getCatalog();
+        if (database == null || database.isEmpty()) {
+            throw new StarRocksConnectorException(
+                    "Snowflake JDBC catalog requires a database: set db=<database> in the JDBC URI");
+        }
+        return database;
+    }
+
+    /** Escapes LIKE wildcards so a metadata pattern matches only the exact name. */
+    private static String exactPattern(DatabaseMetaData metaData, String name) throws SQLException {
+        String escape = metaData.getSearchStringEscape();
+        if (escape == null || escape.isEmpty()) {
+            return name;
+        }
+        return name.replace(escape, escape + escape)
+                .replace("_", escape + "_")
+                .replace("%", escape + "%");
+    }
+
+    @Override
+    public Collection<String> listSchemas(Connection connection) {
+        try {
+            String database = currentDatabase(connection);
+            try (ResultSet resultSet = connection.getMetaData().getSchemas(database, null)) {
+                ImmutableSet.Builder<String> schemaNames = ImmutableSet.builder();
+                while (resultSet.next()) {
+                    String schemaName = resultSet.getString("TABLE_SCHEM");
+                    if (schemaName != null && !isInternalSchema(schemaName)) {
+                        schemaNames.add(schemaName);
+                    }
+                }
+                return schemaNames.build();
+            }
+        } catch (SQLException e) {
+            throw new StarRocksConnectorException(e.getMessage());
+        }
+    }
+
+    @Override
+    public boolean databaseExists(Connection connection, String dbName) throws SQLException {
+        if (isInternalSchema(dbName)) {
+            return false;
+        }
+        return listSchemas(connection).contains(dbName);
+    }
+
+    @Override
+    public ResultSet getTables(Connection connection, String dbName) throws SQLException {
+        DatabaseMetaData metaData = connection.getMetaData();
+        return metaData.getTables(currentDatabase(connection), exactPattern(metaData, dbName), "%",
+                defaultTableTypes);
+    }
+
+    @Override
+    public ResultSet getTables(Connection connection, String dbName, String tblName) throws SQLException {
+        DatabaseMetaData metaData = connection.getMetaData();
+        return metaData.getTables(currentDatabase(connection), exactPattern(metaData, dbName),
+                exactPattern(metaData, tblName), defaultTableTypes);
+    }
+
+    @Override
+    public ResultSet getColumns(Connection connection, String dbName, String tblName) throws SQLException {
+        DatabaseMetaData metaData = connection.getMetaData();
+        return metaData.getColumns(currentDatabase(connection), exactPattern(metaData, dbName),
+                exactPattern(metaData, tblName), "%");
+    }
+
+    private static Map<String, String> withRemoteTableName(Map<String, String> properties, String dbName,
+                                                           String name) {
+        Map<String, String> newProp = new HashMap<>(properties);
+        newProp.putIfAbsent(JDBCTable.JDBC_TABLENAME, quoteIdentifier(dbName) + "." + quoteIdentifier(name));
+        return newProp;
+    }
+
+    @Override
+    public Table getTable(long id, String name, List<Column> schema, String dbName, String catalogName,
+                          Map<String, String> properties) throws DdlException {
+        return new JDBCTable(id, name, schema, dbName, catalogName, withRemoteTableName(properties, dbName, name));
+    }
+
+    @Override
+    public Table getTable(long id, String name, List<Column> schema, List<Column> partitionColumns, String dbName,
+                          String catalogName, Map<String, String> properties) throws DdlException {
+        return new JDBCTable(id, name, schema, partitionColumns, dbName, catalogName,
+                withRemoteTableName(properties, dbName, name));
+    }
+
+    private static String normalizedTypeName(String typeName) {
+        return typeName == null ? "" : typeName.toUpperCase(Locale.ROOT).replace("_", "").trim();
+    }
+
+    private static Type varcharType(int columnSize) {
+        if (columnSize <= 0 || columnSize > TypeFactory.CATALOG_MAX_VARCHAR_LENGTH) {
+            return TypeFactory.createDefaultCatalogString();
+        }
+        return TypeFactory.createVarcharType(columnSize);
+    }
+
+    private Type numberType(int precision, int scale) {
+        if (scale <= 0) {
+            // Mirrors how the driver types the column in result sets (see TREAT_DECIMAL_AS_INT).
+            if (treatDecimalAsInt) {
+                return TypeFactory.createType(PrimitiveType.BIGINT);
+            }
+            return precision > 0 ? TypeFactory.createUnifiedDecimalType(precision, 0)
+                    : TypeFactory.createUnifiedDecimalType(38, 0);
+        }
+        if (precision <= 0 || precision < scale) {
+            return TypeFactory.createDefaultCatalogString();
+        }
+        return TypeFactory.createUnifiedDecimalType(precision, scale);
+    }
+
+    @Override
+    public Type convertColumnType(int dataType, String typeName, int columnSize, int digits) {
+        String snowflakeType = normalizedTypeName(typeName);
+        switch (dataType) {
+            case Types.BOOLEAN:
+            case Types.BIT:
+                return TypeFactory.createType(PrimitiveType.BOOLEAN);
+            case Types.TINYINT:
+            case Types.SMALLINT:
+            case Types.INTEGER:
+            case Types.BIGINT:
+                return numberType(columnSize, 0);
+            case Types.DECIMAL:
+            case Types.NUMERIC:
+                return numberType(columnSize, digits);
+            case Types.REAL:
+            case Types.FLOAT:
+            case Types.DOUBLE:
+                return TypeFactory.createType(PrimitiveType.DOUBLE);
+            case Types.CHAR:
+            case Types.NCHAR:
+            case Types.VARCHAR:
+            case Types.NVARCHAR:
+            case Types.LONGVARCHAR:
+            case Types.LONGNVARCHAR:
+                if (snowflakeType.equals("VARIANT") || snowflakeType.equals("OBJECT")
+                        || snowflakeType.equals("ARRAY")) {
+                    // Semi-structured values are read as JSON text.
+                    return TypeFactory.createType(PrimitiveType.JSON);
+                }
+                return varcharType(columnSize);
+            case Types.BINARY:
+            case Types.VARBINARY:
+            case Types.LONGVARBINARY:
+                return TypeFactory.createVarbinary(TypeFactory.CATALOG_MAX_VARCHAR_LENGTH);
+            case Types.DATE:
+                return TypeFactory.createType(PrimitiveType.DATE);
+            case Types.TIME:
+            case Types.TIME_WITH_TIMEZONE:
+                return TypeFactory.createType(PrimitiveType.TIME);
+            case Types.TIMESTAMP:
+            case Types.TIMESTAMP_WITH_TIMEZONE:
+                // TIMESTAMP_NTZ, TIMESTAMP_LTZ and TIMESTAMP_TZ arrive as java.sql.Timestamp.
+                return TypeFactory.createType(PrimitiveType.DATETIME);
+            case Types.STRUCT:
+            case Types.ARRAY:
+                // Structured OBJECT(...) / ARRAY(...) and VECTOR are read through getString.
+                return TypeFactory.createDefaultCatalogString();
+            default:
+                if (snowflakeType.equals("GEOGRAPHY") || snowflakeType.equals("GEOMETRY")) {
+                    return TypeFactory.createDefaultCatalogString();
+                }
+                return TypeFactory.createType(PrimitiveType.UNKNOWN_TYPE);
+        }
+    }
+
+    @Override
+    public long getTableRowCount(Connection connection, String dbName, String tableName) throws SQLException {
+        // INFORMATION_SCHEMA.TABLES.ROW_COUNT is maintained by Snowflake metadata; no table scan runs.
+        String sql = "SELECT ROW_COUNT FROM " + quoteIdentifier(currentDatabase(connection))
+                + ".INFORMATION_SCHEMA.TABLES WHERE TABLE_SCHEMA = ? AND TABLE_NAME = ?";
+        try (PreparedStatement ps = connection.prepareStatement(sql)) {
+            ps.setString(1, dbName);
+            ps.setString(2, tableName);
+            ps.setQueryTimeout(getQueryTimeoutSeconds());
+            try (ResultSet rs = ps.executeQuery()) {
+                if (rs.next()) {
+                    long rows = rs.getLong(1);
+                    return rs.wasNull() ? -1L : rows;
+                }
+            }
+        }
+        return -1L;
+    }
+
+    @Override
+    public List<Partition> getPartitions(Connection connection, Table table) {
+        return Lists.newArrayList(new Partition(table.getName(), TimeUtils.getEpochSeconds()));
+    }
+}
