+        final List<String> calls = new ArrayList<>();
+        String currentDatabase = DB;
+        List<Map<String, Object>> schemas = rows("TABLE_SCHEM", "INFORMATION_SCHEMA", "PUBLIC", "MY_SCHEMA");
+        List<Map<String, Object>> tables = rows("TABLE_NAME", "ORDERS");
+        List<Map<String, Object>> columns = new ArrayList<>();
+
+        Connection connection() {
+            DatabaseMetaData metaData = proxy(DatabaseMetaData.class, (p, method, args) -> {
+                switch (method.getName()) {
+                    case "getSearchStringEscape":
+                        return "\\";
+                    case "getSchemas":
+                        calls.add("getSchemas(" + args[0] + "," + args[1] + ")");
+                        return resultSet(schemas);
+                    case "getTables":
+                        calls.add("getTables(" + args[0] + "," + args[1] + "," + args[2] + ","
+                                + Arrays.toString((String[]) args[3]) + ")");
+                        return resultSet(tables);
+                    case "getColumns":
+                        calls.add("getColumns(" + args[0] + "," + args[1] + "," + args[2] + "," + args[3] + ")");
+                        return resultSet(columns);
+                    default:
+                        throw new UnsupportedOperationException(method.getName());
+                }
+            });
+            return proxy(Connection.class, (p, method, args) -> {
+                switch (method.getName()) {
+                    case "getCatalog":
+                        return currentDatabase;
+                    case "getMetaData":
+                        return metaData;
+                    case "setNetworkTimeout":
+                    case "close":
+                        return null;
+                    case "isClosed":
+                        return false;
+                    default:
+                        throw new UnsupportedOperationException(method.getName());
+                }
+            });
+        }
+    }
+
+    @SuppressWarnings("unchecked")
+    private static <T> T proxy(Class<T> type, InvocationHandler handler) {
+        return (T) Proxy.newProxyInstance(SnowflakeSchemaResolverTest.class.getClassLoader(),
+                new Class<?>[] {type}, handler);
+    }
+
+    private static List<Map<String, Object>> rows(String column, Object... values) {
+        List<Map<String, Object>> rows = new ArrayList<>();
+        for (Object value : values) {
+            Map<String, Object> row = new HashMap<>();
+            row.put(column, value);
+            rows.add(row);
+        }
+        return rows;
+    }
+
+    private static Map<String, Object> column(String name, int dataType, String typeName, int size, int digits,
+                                              String nullable, String remarks) {
+        Map<String, Object> row = new LinkedHashMap<>();
+        row.put("COLUMN_NAME", name);
+        row.put("DATA_TYPE", dataType);
+        row.put("TYPE_NAME", typeName);
+        row.put("COLUMN_SIZE", size);
+        row.put("DECIMAL_DIGITS", digits);
+        row.put("IS_NULLABLE", nullable);
+        row.put("REMARKS", remarks);
+        return row;
+    }
+
+    private static ResultSet resultSet(List<Map<String, Object>> rows) {
+        int[] cursor = {-1};
+        return proxy(ResultSet.class, (p, method, args) -> {
+            switch (method.getName()) {
+                case "next":
+                    return ++cursor[0] < rows.size();
+                case "getString":
+                    Object s = rows.get(cursor[0]).get((String) args[0]);
+                    return s == null ? null : s.toString();
+                case "getInt":
+                    Object i = rows.get(cursor[0]).get((String) args[0]);
+                    return i == null ? 0 : ((Number) i).intValue();
+                case "close":
+                    return null;
+                default:
+                    throw new UnsupportedOperationException(method.getName());
+            }
+        });
+    }
+
+    private static Map<String, String> catalogProperties(String uri, String driverClass) {
+        Map<String, String> properties = new HashMap<>();
+        properties.put(JDBCResource.DRIVER_CLASS, driverClass);
+        properties.put(JDBCResource.URI, uri);
+        properties.put(JDBCResource.USER, "NOVA");
+        properties.put(JDBCResource.PASSWORD, "unused");
+        properties.put(JDBCResource.DRIVER_URL, "file:///unused/snowflake-jdbc.jar");
+        properties.put(JDBCResource.CHECK_SUM, "1ce46a2882a3e349d37d8afee4e0e7e0");
+        return properties;
+    }
