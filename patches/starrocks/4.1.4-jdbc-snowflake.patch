+package com.starrocks.connector.jdbc;
+
+import com.starrocks.connector.exception.StarRocksConnectorException;
+import org.apache.commons.codec.binary.Hex;
+
+import java.io.File;
+import java.io.IOException;
+import java.io.InputStream;
+import java.net.URI;
+import java.net.URL;
+import java.net.URLClassLoader;
+import java.nio.file.Files;
+import java.security.MessageDigest;
+import java.security.NoSuchAlgorithmException;
+import java.util.Locale;
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+
+/**
+ * Class loaders for JDBC drivers that are not on the FE classpath.
+ *
+ * <p>Only drivers that ship as a local file are loaded, and the file must match the MD5 checksum that
+ * JDBCConnector recorded when the catalog was created (the same checksum the BE verifies). The FE never
+ * fetches driver code from a remote URL at metadata time. One loader is kept per driver file and
+ * checksum so catalogs share loaded classes and a replaced file needs a new checksum.
+ */
+final class JDBCDriverClassLoaders {
+
+    private static final Map<String, ClassLoader> LOADERS = new ConcurrentHashMap<>();
+
+    private JDBCDriverClassLoaders() {
+    }
+
+    static ClassLoader forDriver(String driverUrl, String checksum) {
+        if (driverUrl == null || driverUrl.isEmpty()) {
+            throw new StarRocksConnectorException("Missing driver_url for a driver that is not on the FE classpath");
+        }
+        if (checksum == null || checksum.isEmpty()) {
+            throw new StarRocksConnectorException("Missing checksum for JDBC driver " + driverUrl);
+        }
+        File driverFile = localDriverFile(driverUrl);
+        String key = driverFile.getAbsolutePath() + "#" + checksum.toLowerCase(Locale.ROOT);
+        return LOADERS.computeIfAbsent(key, k -> createLoader(driverFile, checksum));
+    }
+
+    static File localDriverFile(String driverUrl) {
+        URI uri;
+        try {
+            uri = URI.create(driverUrl);
+        } catch (IllegalArgumentException e) {
+            throw new StarRocksConnectorException("Invalid JDBC driver_url: " + driverUrl);
+        }
+        if (!"file".equalsIgnoreCase(uri.getScheme())) {
+            throw new StarRocksConnectorException(
+                    "JDBC driver_url must be a local file:// JAR for drivers not on the FE classpath: " + driverUrl);
+        }
+        File file = new File(uri.getPath());
+        if (!file.isFile()) {
+            throw new StarRocksConnectorException("JDBC driver file not found: " + driverUrl);
+        }
+        return file;
+    }
+
+    static String md5Hex(File file) {
+        try (InputStream in = Files.newInputStream(file.toPath())) {
+            MessageDigest digest = MessageDigest.getInstance("MD5");
+            byte[] buf = new byte[1 << 16];
+            int read;
+            while ((read = in.read(buf)) >= 0) {
+                digest.update(buf, 0, read);
+            }
+            return Hex.encodeHexString(digest.digest());
+        } catch (IOException | NoSuchAlgorithmException e) {
+            throw new StarRocksConnectorException("Cannot read JDBC driver file " + file + ": " + e.getMessage());
+        }
+    }
+
+    private static ClassLoader createLoader(File driverFile, String checksum) {
+        String actual = md5Hex(driverFile);
+        if (!actual.equalsIgnoreCase(checksum)) {
+            throw new StarRocksConnectorException("JDBC driver file " + driverFile
+                    + " does not match the checksum recorded for the catalog");
+        }
+        try {
+            URL url = driverFile.toURI().toURL();
+            return new URLClassLoader(new URL[] {url}, JDBCDriverClassLoaders.class.getClassLoader());
+        } catch (IOException e) {
+            throw new StarRocksConnectorException("Cannot load JDBC driver file " + driverFile + ": " + e.getMessage());
+        }
+    }
+}
