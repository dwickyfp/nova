{
  "name": "nova-e2e",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.3 || >=24.8.0"
  },
  "scripts": {
    "e2e": "E2E_TELEMETRY_DISABLED=1 e2e run",
    "e2e:chromium": "E2E_TELEMETRY_DISABLED=1 e2e run --target chromium",
    "e2e:lightpanda": "E2E_TELEMETRY_DISABLED=1 e2e run --target lightpanda --exclude-tag layout"
  },
  "devDependencies": {
    "@e2e-dev/lightpanda": "0.0.1",
    "@e2e-dev/web": "0.15.4",
    "e2e": "0.22.0"
  }
}
