# Nova Backend Configuration
# Copy to .env and customize

# --- StarRocks ---
STARROCKS_HOST=localhost
STARROCKS_FE_MYSQL_PORT=9030
STARROCKS_HTTP_PORT=8030
STARROCKS_ARROW_FLIGHT_PORT=9408
STARROCKS_ROOT_USER=root
STARROCKS_ROOT_PASSWORD=

# --- Native ML execution ---
ML_ARROW_ENABLED=true
ML_ARROW_BATCH_SIZE=65536
ML_MYSQL_BATCH_SIZE=4096
ML_INTERACTIVE_TIMEOUT_SECONDS=10
ML_BALANCED_TIMEOUT_SECONDS=60
ML_BEST_TIMEOUT_SECONDS=300
ML_MAX_INTERACTIVE_ROWS=500000
ML_MAX_INTERACTIVE_BYTES=536870912
ML_MAX_CONCURRENCY=2
ML_WORKER_PROCESSES=2
ML_ARTIFACT_STORAGE_CONNECTION=production
ML_ARTIFACT_PREFIX=nova/ml-artifacts
ML_MODEL_CACHE_MAX_MODELS=32
ML_MODEL_CACHE_MAX_BYTES=1073741824
ML_MODEL_CACHE_TTL_SECONDS=900
ML_EPHEMERAL_TTL_SECONDS=1800
ML_RANDOM_SEED=42

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Security ---
# Both values are REQUIRED. The backend refuses to start without them: an
# unset signing key would let anyone forge sessions, and an unset Fernet key
# would change on every restart, making stored secrets undecryptable.
# Generate with: openssl rand -hex 32
SECRET_KEY=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
SESSION_TTL_SECONDS=3600

# --- Internal machine-to-machine channel (/api/v1/internal/*) ---
# Shared secret for callers with no Nova session (e.g. the ML_PREDICT UDF).
# Leave empty only if the internal endpoints are unused: they fail closed (503).
# Also set NOVA_INTERNAL_TOKEN in the process that runs the UDF (the UDF reads
# it from the environment, or from the `nova.backend.token` system property).
# NOVA_INTERNAL_TOKEN=
# Comma-separated extra peer addresses allowed to reach internal endpoints,
# in addition to loopback. Set to the trusted proxy that forwards BE traffic.
# NOVA_INTERNAL_TRUSTED_PROXY=

# --- MinIO / S3 ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=nova-stages

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# --- App ---
DEBUG=false
LOG_LEVEL=INFO
