# ═══════════════════════════════════════════════════════════════
# Nova Environment Configuration
# Copy to .env and customize
# ═══════════════════════════════════════════════════════════════

# ── Timezone ──
TZ=Asia/Jakarta

# ── MinIO ──
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=miniopassword
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=AKIAIOSFODNN7EXAMPLE
MINIO_SECRET_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# ── Redis ──
REDIS_PORT=6379
REDIS_PASSWORD=nova_redis_2026

# ── StarRocks FE ──
FE_HTTP_PORT=8030
FE_RPC_PORT=9020
# NOTE: 9030 is NOT exposed to host (Docker internal only)
# docker-compose.dev.yml may bind it to this loopback-only development port.
STARROCKS_DEV_MYSQL_PORT=29030

# ── Apache Ranger (local development values only) ──
RANGER_VERSION=2.9.0
RANGER_ADMIN_PORT=6080
RANGER_SOLR_PORT=8983
RANGER_DB_PASSWORD=rangerR0cks!
RANGER_ADMIN_PASSWORD=rangerR0cks!
RANGER_SERVICE_NAME=nova_starrocks

# ── StarRocks BE ──
BE_HTTP_PORT=8040
BE_HEARTBEAT_PORT=9050

# ── Nova Backend (when scaffolded) ──
NOVA_API_PORT=8000
NOVA_MYSQL_PORT=4406
NOVA_SECRET_KEY=change-me-in-production
# Generate once with Fernet.generate_key() and preserve across container restarts.
NOVA_FERNET_KEY=

# app profile worker: a dedicated StarRocks account, never root or nova_admin.
WORKER_IMPERSONATION_USER=
WORKER_IMPERSONATION_PASSWORD=
WORKER_IMPERSONATION_ROLE=
# Provisioned Grafana admin login. Store a unique value in docker/.env.
GRAFANA_ADMIN_PASSWORD=
GRAFANA_ADMIN_USER=admin
GRAFANA_PORT=3001
GRAFANA_ROOT_URL=http://localhost:3001
PROMETHEUS_PORT=9090
# host: processes from ../dev.sh; container: app profile services in Compose.
NOVA_METRICS_MODE=host
# Enable only after a restorable target backup exists.
MIGRATION_EXECUTE_ENABLED=false

# ── Nova Frontend (when scaffolded) ──
NOVA_WEB_PORT=3000

# ═══════════════════════════════════════════════════════════════
# Auth Model (DO NOT CHANGE)
# ═══════════════════════════════════════════════════════════════
#
# root       → empty password, Docker internal only (NOT exposed)
# nova_admin → default 'nova', first login forces password change
# Role:      ACCOUNTADMIN
#
# All login users ARE StarRocks users (no separate user table).
# ═══════════════════════════════════════════════════════════════
