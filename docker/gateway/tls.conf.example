# HTTPS listener for the Nova gateway.
#
# To enable: copy this file to docker/gateway/tls/tls.conf, put the certificate
# and key in the directory named by NOVA_TLS_CERT_DIR (default
# docker/gateway/tls) as tls.crt and tls.key, and restart nova-gateway. The
# listener is published on NOVA_API_TLS_PORT (default 8443).
server {
  listen 8443 ssl;
  ssl_certificate /etc/nginx/certs/tls.crt;
  ssl_certificate_key /etc/nginx/certs/tls.key;
  ssl_protocols TLSv1.2 TLSv1.3;
  include /etc/nginx/nova-routes.conf;
}
