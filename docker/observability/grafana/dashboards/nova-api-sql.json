    {
      "type": "stat",
      "title": "API scrape",
      "description": "Prometheus scrape state. No data means this target is not configured.",
      "datasource": {
        "type": "prometheus",
        "uid": "nova-prometheus"
      },
      "targets": [
        {
          "expr": "max(up{job=\"nova-backend\"})",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "color": "red"
                },
                "1": {
                  "text": "Up",
                  "color": "green"
                }
              }
            }
          ],
          "noValue": "Not configured",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
