    {
      "type": "stat",
      "title": "HTTP 5xx rate",
      "description": "Share of completed requests returning a server error.",
      "datasource": {
        "type": "prometheus",
        "uid": "nova-prometheus"
      },
      "targets": [
        {
          "expr": "(sum(rate(nova_http_requests_total{job=\"nova-backend\",status=~\"5..\"}[5m])) or vector(0)) / clamp_min(sum(rate(nova_http_requests_total{job=\"nova-backend\"}[5m])), 0.001)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 4
      },
      "transparent": false,
      "options": {
