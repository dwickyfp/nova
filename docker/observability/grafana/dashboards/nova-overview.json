    {
      "type": "stat",
      "title": "Pending + lag",
      "description": "Redis stream lag plus pending deliveries. Each worker reports the same group depth.",
      "datasource": {
        "type": "prometheus",
        "uid": "nova-prometheus"
      },
      "targets": [
        {
          "expr": "max(nova_worker_queue_depth{job=\"nova-worker\"})",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
