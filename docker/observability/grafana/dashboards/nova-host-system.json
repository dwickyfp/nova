        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "id": 4
    },
    {
      "type": "stat",
      "title": "Memory used",
      "description": "Uses MemAvailable so reclaimable cache is not counted as pressure.",
