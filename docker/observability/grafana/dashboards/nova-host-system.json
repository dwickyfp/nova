    {
      "type": "stat",
      "title": "Runtime filesystem",
      "description": "Linux root filesystem when available, otherwise Docker data at /var/lib/docker (OrbStack).",
      "datasource": {
        "type": "prometheus",
        "uid": "nova-prometheus"
      },
      "targets": [
        {
          "expr": "max((100 * (1 - node_filesystem_avail_bytes{job=\"node-exporter\",mountpoint=\"/\",fstype=~\"btrfs|ext4|xfs|zfs|f2fs\"} / node_filesystem_size_bytes{job=\"node-exporter\",mountpoint=\"/\",fstype=~\"btrfs|ext4|xfs|zfs|f2fs\"})) or on(instance) (100 * (1 - node_filesystem_avail_bytes{job=\"node-exporter\",mountpoint=\"/var/lib/docker\",fstype=~\"btrfs|ext4|xfs|zfs|f2fs\"} / node_filesystem_size_bytes{job=\"node-exporter\",mountpoint=\"/var/lib/docker\",fstype=~\"btrfs|ext4|xfs|zfs|f2fs\"})))",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
