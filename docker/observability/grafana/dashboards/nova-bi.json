    {
      "type": "stat",
      "title": "Metrics exporter",
      "description": "Prometheus scrape state. No data means this target is not configured.",
      "datasource": {
        "type": "prometheus",
        "uid": "nova-prometheus"
      },
      "targets": [
        {
          "expr": "max(up{job=\"bi-metrics\"})",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "color": "red"
                },
                "1": {
                  "text": "Up",
                  "color": "green"
                }
              }
            }
          ],
          "noValue": "Not configured",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 4
      },
      "transparent": false,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
